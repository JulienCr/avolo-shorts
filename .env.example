FFMPEG_BIN=/home/julien/.local/opt/ffmpeg-nvenc/bin/ffmpeg
FFPROBE_BIN=/home/julien/.local/opt/ffmpeg-nvenc/bin/ffprobe
FFMPEG_ENCODER=auto
REPLAY_DIR=/mnt/j/Drive partagés/Avolo/03_LA_SCENE_AVOLO/Replay
STAGE_DIR=./stage
PROJECTS_DIR=./projects
# La valeur, ou l'adresse d'un secret 1Password — résolue au démarrage, une
# seule fois, par `op read`. Voir docs/environnement.md.
#   GEMINI_API_KEY=op://<coffre>/<fiche>/<champ>
# Le modèle de chaque usage se règle depuis l'écran Paramètres, pas ici.
GEMINI_API_KEY=
# Facultative : seulement si un usage d'IA choisit OpenAI.
OPENAI_API_KEY=
# Upload Post (docs.upload-post.com) : le transport de publication. Une clé
# ne tourne pas, donc pas de script de connexion — connecter les comptes
# sociaux se fait sur leur propre site.
#   UPLOAD_POST_API_KEY=op://<coffre>/<fiche>/<champ>
UPLOAD_POST_API_KEY=
# Le profil Upload Post à utiliser (celui que la clé ci-dessus autorise).
UPLOAD_POST_USER=
# Meta direct (Instagram Reels, Facebook Page Reels — issue #146). L'app id et
# le secret ne tournent pas : 1Password. Le jeton Instagram, lui, tourne (60
# jours) et vit hors dépôt, dans projects/meta-tokens.json — voir
# scripts/dev-connect-meta.ts, qui l'y écrit.
#   META_APP_ID=op://<coffre>/<fiche>/<champ>
#   META_APP_SECRET=op://<coffre>/<fiche>/<champ>
META_APP_ID=
META_APP_SECRET=
# La Page Facebook rattachée, et son jeton — dérivé d'un jeton utilisateur
# longue durée, il n'expire pas (spec §7) : 1Password aussi. L'identifiant
# de Page n'est pas un secret, il reste en clair.
META_PAGE_ID=
#   META_PAGE_TOKEN=op://<coffre>/<fiche>/<champ>
META_PAGE_TOKEN=
# La page de retour OAuth sur avolo.fr (lot 0 de la conception publication).
META_REDIRECT_URI=https://avolo.fr/meta/oauth-callback
# TikTok direct (dépôt en brouillon, spec §2.3). L'app id et le secret ne
# tournent pas : 1Password — la section Prod ou Sandbox selon l'environnement
# visé, jamais les deux en dur. Le jeton, lui, tourne (24 h, rafraîchissement
# 365 j) et vit hors dépôt, dans projects/tiktok-tokens.json — voir
# scripts/dev-connect-tiktok.ts, qui l'y écrit.
#   TIKTOK_CLIENT_KEY=op://<coffre>/<fiche>/<champ>
#   TIKTOK_CLIENT_SECRET=op://<coffre>/<fiche>/<champ>
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# La boucle locale est acceptée pour cette app (spec §2.3) : rien à héberger.
TIKTOK_REDIRECT_URI=http://127.0.0.1:4005/tiktok/oauth-callback/
SCORE_BATCH=8
WHISPER_PYTHON=/home/julien/dev/rythmo-impro/diarizer/venv/bin/python
WHISPER_MODEL=large-v3
DETECT_PYTHON=./worker/venv/bin/python
# Les poids de pose : dix-sept points par personne en plus de la boîte, dont le
# cadrage déduit le tronc. Repasser sur yolo11m.pt refait une analyse sans
# points, où le cadrage retombe sur la boîte **rognée** — et sur une autre
# population de boîtes : la pose ne détecte presque pas les têtes de spectateurs
# de premier rang (2 429 contre 8 325 sur cqlp). Voir docs/premier-plan.md.
DETECT_MODEL=./worker/models/yolo11m-pose.pt
