/**
 * Mots dont l'accent porte le sens — la clé est le mot **original**
 * (accents conservés), en minuscules, consultée avant `FR_TO_EN` sur sa
 * forme sans accent. Un seul cas connu à ce jour : « sûr » (safe) contre
 * « sur » (on), identiques une fois l'accent retiré.
 */
export const ACCENT_SENSITIVE_OVERRIDES: Record<string, string> = {
  "sûr": "safe",
  "où": "where",
  // "résumé" (summary) sans accent devient "resume" — un vrai mot anglais
  // (reprendre) déjà utilisé comme traduction de "reprise"/"reprendre" plus
  // haut dans FR_TO_EN. Une entrée FR_TO_EN["resume"] collisionnerait donc
  // avec ce mot anglais partout où il apparaît légitimement (y compris nos
  // propres traductions) ; ancrée ici sur la forme accentuée, elle ne
  // touche que "résumé" lui-même.
  "résumé": "summary",
  // "force" (sans accent) est déjà un mot anglais légitime — la convention
  // même des flags `--force` de git/npm — et le rester est ce dépôt en fait
  // un usage constant (32 déclarations, jamais un mot français). Seule sa
  // forme accentuée porte le participe passé "forcé(e)".
  "forcé": "forced",
  "forcée": "forced",
  "forcées": "forced",
  "forcés": "forced",
};

function buildDictionary(entries: Array<[string, string]>): Record<string, string> {
  const dict: Record<string, string> = {};
  for (const [key, value] of entries) {
    if (key in dict) {
      throw new Error(`Clé dupliquée dans le dictionnaire de renommage : "${key}"`);
    }
    dict[key] = value;
  }
  return dict;
}

export const FR_TO_EN: Record<string, string> = buildDictionary(ENTRIES);

/**
 * Phrases entières (identifiant complet ou fragment multi-mots) qui ne se
 * traduisent pas correctement mot à mot — l'ordre français-anglais diffère,
 * ou le sens dépend de la combinaison entière. Remplies au fil de table.mts,
 * contre le fichier qui les porte.
 */
export const PHRASE_OVERRIDES: Record<string, string> = {
  // Superlatif : "le plus large" ne se traduit pas mot à mot.
  LE_PLUS_LARGE: "WIDEST",
  // "ce qu'on incrusterait [maintenant]" : un type nommé pour son usage
  // (`observé: CeQuOnIncrusterait`) plutôt que traduit mot à mot.
  CeQuOnIncrusterait: "ObservedBurnIn",
  // "en attente" est une locution, pas "en" + "attente" mis bout à bout.
  GrilleEnAttente: "PendingGrid",
  // Aligné sur `captionsLook`, déjà le nom du champ persisté équivalent
  // (issue #73, passée 4 — voir le commentaire au-dessus de VERSION_EMPREINTE
  // dans src/server/steps/render.ts) : les deux doivent se lire pareil.
  LookDesSousTitres: "CaptionsLook",
  // "état d'enregistrement" (état de sauvegarde différée, pas d'un
  // enregistrement audio/vidéo — voir la note sur "enregistrement" plus haut) :
  // l'ordre mot à mot ("StateAutosave") lit à l'envers.
  EtatEnregistrement: "AutosaveState",
  // "useEnregistrementAuto" traduit mot à mot doublerait "autosave" et "auto"
  // ("useAutosaveAuto") : le nom du hook porte déjà l'idée d'automatique.
  useEnregistrementAuto: "useAutosave",
  // Composé direct sans "de" (donc hors de la portée du réordonnancement
  // mécanique) mais dont l'ordre mot à mot ("LineEditing") lit à l'envers.
  LigneMontage: "EditingLine",

  // Résidus de classify.mts : mot-outil seul, qui n'est un nom valide qu'une
  // fois compris dans son contexte plutôt que traduit en générique.
  // `échantillon(de: number, à: number, ...)` — bornes d'un intervalle.
  de: "from",
  é: "step", // `ÉTAPES.some((é) => é.nom === ...)` — variable de boucle sur une étape.

  // Collisions avec un mot réservé JS/TS (classify.mts les remonte en résidu
  // plutôt que d'écrire une syntaxe invalide — voir RESERVED_WORDS) :
  // "défaut"/"cas"/"faux" isolés traduiraient vers "default"/"case"/"false",
  // aucun des trois n'est un nom de liaison valide.
  défaut: "defaultValue", // `function setting(value, défaut: number)`, `const défaut = process.env[x] ?? défaut` — la valeur de repli elle-même.
  retour: "returning", // `const { ..., retour } = lireSessionTri(...)` — le drapeau "on revient d'un clip", jamais la valeur de retour d'une fonction.
  nouveaux: "freshClips", // `const nouveaux: Clip[] = []` — les candidats du lot qui ne collisionnent avec aucun clip déjà gardé.
  avec: "included", // `const avec = phaseProjet(...); const sans = phaseProjet(...)` et `(avec: boolean) => ...` — s'accorde avec "sans" → "without" déjà en place.
  nul: "nullDimensions", // `const nul = { ...ANALYSE_VALIDE, proxy: { w: 0, h: 540 } }` — un fixture de test, pas le mot "nul" en général.
};
