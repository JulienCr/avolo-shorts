{
  "name": "avolo-shorts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4005",
    "build": "next build",
    "start": "next start -p 4005",
    "lint": "eslint",
    "test": "vitest run",
    "type-check": "next typegen && tsc --noEmit",
    "framing-preview": "tsx scripts/framing-preview.ts",
    "framing-preview:stop": "lsof -t -iTCP:${PORT:-4321} -sTCP:LISTEN | xargs -r kill -INT",
    "generate-env:local": "tsx scripts/generate-env-local.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.17.1",
    "@napi-rs/canvas": "^1.0.7",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11"
  }
}
